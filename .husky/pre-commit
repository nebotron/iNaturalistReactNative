set -e

# Install dependencies if they're missing (e.g. fresh cloud containers).
# GitHub deps install via git clone when codeload tarballs are blocked. Hooks
# inherit GIT_INDEX_FILE (this commit's index), which npm's `git checkout` in
# each temp clone would then use, aborting on "local changes" (and surfacing as
# "destination path ... already exists" once npm retries into the same dir), so
# drop it for the install. Retry the whole install for real network failures.
for attempt in 1 2 3; do
  [ -d node_modules ] && break
  env -u GIT_INDEX_FILE npm install --no-audit --no-fund && break
  [ "$attempt" = 3 ] && exit 1
  echo "npm install failed (attempt $attempt), retrying..." >&2
done
bundle check > /dev/null 2>&1 || bundle install --quiet
# Gem executables (e.g. rubocop) aren't always on PATH
export PATH="$(ruby -e 'print Gem.bindir'):$PATH"

# Run lint on staged files and run flow
npm run lint:staged:fix

# Generate translations from strings.ftl
npm run translate
# ...and add them to the commit; this assumes src/i18n/l10n/ *only* contains
#    files you want to add
git status --porcelain --untracked-files src/i18n/l10n/ \
  | grep -v "D .*" \
  | cut -c 4- \
  | xargs git add
