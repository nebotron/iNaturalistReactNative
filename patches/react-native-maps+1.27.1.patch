+// Counts of what the tile layers hold and do, for the app's memory snapshots
+// (ImageCropper memorySnapshot reads AIRMapUrlTileMemoryStats through the
+// Objective-C runtime). Kept here and in AIRMapUrlTileCachedOverlay.m.
+static NSString *const AIRMapUrlTileCountNames[AIRMapUrlTileCountKeys] = {
+    [AIRMapUrlTileCountLiveOverlays] = @"liveOverlays",
+    [AIRMapUrlTileCountOverlaysCreated] = @"overlaysCreated",
+    [AIRMapUrlTileCountLiveRenderers] = @"liveRenderers",
+    [AIRMapUrlTileCountTileLoads] = @"tileLoads",
+    [AIRMapUrlTileCountTileLoadsInFlight] = @"tileLoadsInFlight",
+    [AIRMapUrlTileCountTileLoadKB] = @"tileLoadKB",
+    [AIRMapUrlTileCountFallbackDraws] = @"fallbackDraws",
+    [AIRMapUrlTileCountFallbackDecodedKB] = @"fallbackDecodedKB",
+    [AIRMapUrlTileCountDiskHits] = @"diskHits",
+    [AIRMapUrlTileCountNetworkFetches] = @"networkFetches",
+    [AIRMapUrlTileCountNetworkFetchesInFlight] = @"networkFetchesInFlight",
+    [AIRMapUrlTileCountRefreshes] = @"refreshes",
+    [AIRMapUrlTileCountRefreshesInFlight] = @"refreshesInFlight",
+};
+static _Atomic long AIRMapUrlTileCounts[AIRMapUrlTileCountKeys];
+
+void AIRMapUrlTileCount(AIRMapUrlTileCountKey key, long delta) {
+    atomic_fetch_add(&AIRMapUrlTileCounts[key], delta);
+}
+
+@interface AIRMapUrlTileMemoryStats : NSObject
+@end
+@implementation AIRMapUrlTileMemoryStats
++ (NSDictionary *)stats {
+    NSMutableDictionary *stats = [NSMutableDictionary new];
+    for (int key = 0; key < AIRMapUrlTileCountKeys; key++) {
+        stats[AIRMapUrlTileCountNames[key]] = @(atomic_load(&AIRMapUrlTileCounts[key]));
+    }
+    return stats;
+}
+@end
+
+// A tile load's start, and its end with the bytes it got
+static void AIRMapUrlTileLoadStarted(void) {
+    AIRMapUrlTileCount(AIRMapUrlTileCountTileLoads, 1);
+    AIRMapUrlTileCount(AIRMapUrlTileCountTileLoadsInFlight, 1);
+}
+static void AIRMapUrlTileLoadEnded(NSData *data) {
+    AIRMapUrlTileCount(AIRMapUrlTileCountTileLoadsInFlight, -1);
+    AIRMapUrlTileCount(AIRMapUrlTileCountTileLoadKB, (long)(data.length / 1024));
+}
+
+// On iOS, a plain MKTileOverlayRenderer intermittently never paints its tiles, leaving
+// the tile layer invisible until the user pans or zooms. MapKit invalidates tile overlays
+// when other overlays are added or removed, which our maps do constantly. Rendering
+// through a subclass avoids it -- but note the overrides below are pure super calls:
+// they look like dead code and are not, and nobody has established why subclassing
+// makes any difference. Don't "clean this up" without retesting on iOS.
+// MapKit bug, Apple-confirmed: https://developer.apple.com/forums/thread/125631
+// Only known workaround, filed as FB9957545: https://github.com/briancoyner/MKOverlayRendererBug
+//
+// The renderer also keeps old tiles on screen until new ones load. MKTileOverlayRenderer
+// blanks any area whose tiles at the current zoom haven't loaded, so pinching or changing
+// the URL template (a new search, or the grid/points switch) cleared the layer. Every
+// loaded tile is kept in a shared cache, and an area the renderer can't draw yet is
+// filled from cached tiles at nearby zooms, or from the previous URL template.
+static NSCache *AIRMapUrlTileFallbackCache(void) {
+    static NSCache *cache;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        cache = [[NSCache alloc] init];
+        cache.totalCostLimit = 32 * 1024 * 1024;
+    });
+    return cache;
+}
+
+static NSString *AIRMapUrlTileFallbackKey(NSString *urlTemplate, NSInteger z, NSInteger x, NSInteger y) {
+    return [NSString stringWithFormat:@"%ld/%ld/%ld/%@", (long)z, (long)x, (long)y, urlTemplate];
+}
+
+@interface AIRMapUrlTileFallbackOverlay : MKTileOverlay
+@end
+@implementation AIRMapUrlTileFallbackOverlay
+- (instancetype)initWithURLTemplate:(NSString *)URLTemplate {
+    self = [super initWithURLTemplate:URLTemplate];
+    if (self) {
+        AIRMapUrlTileCount(AIRMapUrlTileCountLiveOverlays, 1);
+        AIRMapUrlTileCount(AIRMapUrlTileCountOverlaysCreated, 1);
+    }
+    return self;
+}
+- (void)dealloc {
+    AIRMapUrlTileCount(AIRMapUrlTileCountLiveOverlays, -1);
+}
+- (void)loadTileAtPath:(MKTileOverlayPath)path result:(void (^)(NSData *, NSError *))result {
+    NSString *urlTemplate = self.URLTemplate;
+    AIRMapUrlTileLoadStarted();
+    [super loadTileAtPath:path result:^(NSData *data, NSError *error) {
+        AIRMapUrlTileLoadEnded(data);
+        if (data.length > 0 && urlTemplate) {
+            [AIRMapUrlTileFallbackCache() setObject:data
+                                             forKey:AIRMapUrlTileFallbackKey(urlTemplate, path.z, path.x, path.y)
+                                               cost:data.length];
+        }
+        result(data, error);
+    }];
+}
+@end
+
+// The same, for tiles also cached on disk (tileCachePath)
+@interface AIRMapUrlTileFallbackCachedOverlay : AIRMapUrlTileCachedOverlay
