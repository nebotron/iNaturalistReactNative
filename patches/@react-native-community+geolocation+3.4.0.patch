@@ -412,7 +412,13 @@
                           useSignificantChanges:options.useSignificantChanges];
 
   if (didPause) {
-    [self startObserving];
+    // iNaturalist patch: RNCGeolocation subclasses RCTEventEmitter, whose
+    // -startObserving takes no arguments, so this call resolved to that no-op
