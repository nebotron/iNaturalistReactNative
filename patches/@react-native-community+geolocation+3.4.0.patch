@@ -187,6 +187,29 @@
   _locationManager.distanceFilter  = distanceFilter;
   _locationManager.desiredAccuracy = desiredAccuracy;
   _usingSignificantChanges = useSignificantChanges;
+
+  // iNaturalist patch: pausesLocationUpdatesAutomatically defaults to YES, so
+  // iOS pauses background location updates whenever it decides the user is
+  // stationary and does not resume them on its own for a long time, which
+  // leaves long gaps in the tracked location history. Keep updates flowing
+  // continuously whenever we've opted into background updates (i.e. our
+  // location history tracker); foreground-only watches are unaffected.
+  if (_locationConfiguration.enableBackgroundLocationUpdates) {
+    _locationManager.pausesLocationUpdatesAutomatically = NO;
+
+    // Scope battery tuning to the location-history background watch only. It is
+    // the sole caller that begins updates while skipPermissionRequests == NO
+    // (see IOS_BACKGROUND_TRACKING_GEOLOCATION_CONFIG); every other consumer,
+    // e.g. getCurrentPosition for observation geotagging, runs with
+    // skipPermissionRequests == YES and must keep full (best) accuracy.
+    if (!_locationConfiguration.skipPermissionRequests) {
+      // ~10 m is plenty to geotag photos and draws far less power than
+      // kCLLocationAccuracyBest, and CLActivityTypeFitness tells iOS this is a
+      // moving-on-foot session so it can manage the location radio accordingly.
+      _locationManager.desiredAccuracy = kCLLocationAccuracyNearestTenMeters;
+      _locationManager.activityType = CLActivityTypeFitness;
+    }
+  }

