+++ b/node_modules/@candlefinance/faster-image/ios/CachePolicy.swift
@@ -1,17 +1,35 @@
 /// How aggressively the cache should be used.
 enum CachePolicy: String {
     case memory, discWithCacheControl, discNoCacheControl, memoryAndDisc
-    
+
+    // Pipelines are shared instead of being rebuilt per view. Every
+    // ImagePipeline owns its own operation queues and in-flight task pool, so
+    // constructing one per mounted image (the upstream behavior) both
+    // multiplies thread pools across a scrolling list and stops Nuke from
+    // coalescing duplicate requests for the same URL.
+    private static let memoryPipeline = ImagePipeline.shared
+
+    private static let urlCachePipeline = ImagePipeline(configuration: .withURLCache)
+
+    /// Aggressive disk cache (`DataCache`) that ignores HTTP cache headers.
+    ///
+    /// The size limit is deliberately unbounded. `DataCache` writes to
+    /// `Library/Caches`, which iOS purges under disk pressure and excludes from
+    /// backups, so the system already evicts on our behalf and can let the
+    /// cache grow to the free space actually available. Nuke's own hourly LRU
+    /// sweep short-circuits on `guard size > sizeLimit`, so it becomes a no-op
+    /// rather than throwing away images the device still has room for.
+    static let dataCachePipeline = ImagePipeline(configuration: .withDataCache(sizeLimit: .max))
+
     var pipeline: ImagePipeline {
         switch self {
         case .memory:
-            return .shared
+            return Self.memoryPipeline
         case .discWithCacheControl, .memoryAndDisc:
           // A configuration with an HTTP disk cache (URLCache) with a size limit of 150 MB. This is a default configuration. Also uses shared for in-memory caching.
-            return ImagePipeline(configuration: .withURLCache)
+            return Self.urlCachePipeline
         case .discNoCacheControl:
-          // A configuration with an aggressive disk cache (DataCache) with a size limit of 150 MB. An HTTP cache (URLCache) is disabled.
-            return ImagePipeline(configuration: .withDataCache)
+            return Self.dataCachePipeline
         }
     }
 }
